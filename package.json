{
  "name": "cahen-digital-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 0.0.0.0",
    "start": "node server.mjs",
    "admin:hash": "node scripts/hash-password.mjs",
    "admin:check": "node scripts/check-admin.mjs",
    "sms:check": "node scripts/check-sms.mjs",
    "netlify:check": "node scripts/check-netlify.mjs",
    "film:video": "node scripts/hero-video.mjs",
    "film:placeholder": "node scripts/hero-video.mjs --placeholder",
    "hero:check": "node scripts/check-hero.mjs",
    "verify": "npm run typecheck && npm run hero:check && npm run admin:check && npm run sms:check && npm run netlify:check"
  },
  "dependencies": {
    "@fontsource-variable/estedad": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource-variable/vazirmatn": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@netlify/blobs": "^8.2.0",
    "clsx": "2.1.1",
    "lucide-react": "^1.55.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.4.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "5.1.1",
    "esbuild": "^0.28.2",
    "jsdom": "^25.0.1",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
