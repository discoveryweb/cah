# Server-only configuration. Never prefix these with VITE_ — anything with that
# prefix is compiled into the public JavaScript bundle.
#
# The admin panel (/shenataisoni) has no built-in account: it reads the owner's
# email and password hash from these variables at runtime. Define them in the
# hosting environment (for Netlify: Site configuration → Environment variables)
# or in a local .env file that stays out of version control.

# Owner email used to sign in.
ADMIN_EMAIL=

# Preferred: a scrypt hash produced by `npm run admin:hash -- "your passphrase"`.
# The plain password is never stored in a file or sent to the browser.
ADMIN_PASSWORD_HASH=

# Fallback for quick setups. Minimum 12 characters; it is hashed in memory at
# boot and never written to disk. Prefer ADMIN_PASSWORD_HASH in production.
ADMIN_PASSWORD=

# Display name shown in the panel (optional, defaults to the email prefix).
ADMIN_NAME=

# Random signing key for session cookies; 32+ characters. Rotating it signs out
# every device immediately. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_SESSION_SECRET=

# Session lifetime in hours (1–72, default 8).
ADMIN_SESSION_HOURS=8

# Optional extra managers, JSON array. Only editor/viewer roles are allowed here;
# the owner comes from ADMIN_EMAIL above. Build each passwordHash with admin:hash.
# Accounts created from the panel (Administrators → add) are stored as scrypt
# hashes in the storage layer; the accounts defined here stay read-only in the
# panel and can only be changed by editing these variables.
# ADMIN_TEAM=[{"email":"editor@studio.com","name":"Editor","role":"editor","passwordHash":"scrypt$…"}]

# Set to true only when TLS terminates in front of the server and you want the
# session cookie marked Secure even without X-Forwarded-Proto.
ADMIN_COOKIE_SECURE=false

# Netlify Blobs store name used by the serverless function. Deploy previews and
# branch deploys automatically use "<name>-preview" so they cannot overwrite
# production content or orders.
ADMIN_BLOB_STORE=cahen-admin

# --- Collaboration SMS notification -----------------------------------------
# Orders are stored first and texted afterwards. If any value below is missing
# the order is kept with status "pending" and can be re-sent from the Orders tab
# once the configuration is complete — nothing is lost.
# Iranian manager mobile that receives the lead notification, e.g. 09123456789
ORDER_MANAGER_PHONE=

# National Messagek (Melipayamak) account details.
MELIPAYAMAK_USERNAME=
# Prefer the API key if the account requires it; the API key is sent in the documented password field.
MELIPAYAMAK_API_KEY=
# Use this only when the account uses a password rather than an API key.
MELIPAYAMAK_PASSWORD=
# An active, web-service-enabled sender number from the National Messagek panel.
MELIPAYAMAK_FROM=

# Set true only when the app is behind a trusted reverse proxy that sets X-Forwarded-For.
# Netlify sets NETLIFY/SITE_ID, so proxy headers are trusted there automatically.
TRUST_PROXY=false

# Optional. The Node production server defaults to port 4173.
PORT=4173
