# Server-only configuration for the collaboration SMS notification. Do not use VITE_ prefixes.
# Iranian manager mobile that receives the lead notification, e.g. 09123456789
ORDER_MANAGER_PHONE=

# National Messagek (Melipayamak) account details.
MELIPAYAMAK_USERNAME=
# Prefer the API key if the account requires it; the API key is sent in the documented password field.
MELIPAYAMAK_API_KEY=
# Use this only when the account uses a password rather than an API key.
MELIPAYAMAK_PASSWORD=
# An active, web-service-enabled sender number from the National Messagek panel.
MELIPAYAMAK_FROM=

# Set true only when the app is behind a trusted reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=false

# Optional. The Node production server defaults to port 4173.
PORT=4173
